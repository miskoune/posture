---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import InsideTheApp from '../components/InsideTheApp.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

/**
 * Rule 6 — one idea per screen, in the order a sceptic asks for them:
 * show it, tour it, prove it, place it, answer the rest. The hero's window
 * demo carries what the problem, how-it-works, and price sections used to
 * say, so those screens are gone rather than repeated.
 */
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <InsideTheApp />
    <Faq />
  </main>
  <Footer />
</Layout>
