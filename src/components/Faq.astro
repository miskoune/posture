---
import { faqs } from '../data/faq';
---

<section class="ps-screen" id="ps-faq">
  <div class="ps-shell max-w-[46rem]">
    <p class="ps-kicker">Questions</p>
    <h2 class="mt-4 text-[clamp(1.9rem,4.2vw,2.9rem)]">
      Reasonable suspicions, answered.
    </h2>

    <div class="mt-12 border-t border-line">
      {
        faqs.map((faq, i) => (
          <details
            class="ps-faq group border-b border-line"
            name="ps-faq"
            open={i === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[1.02rem] font-medium">
              {faq.q}
              <svg
                class="h-[18px] w-[18px] shrink-0 stroke-muted transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="pb-6 text-[0.97rem] text-muted">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Safari still paints the default triangle without this */
  .ps-faq summary::-webkit-details-marker {
    display: none;
  }
</style>
