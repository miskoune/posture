---
import DownloadIcon from './DownloadIcon.astro';
import { site } from '../config/site';

/**
 * Rules 1, 8, 12, 27 and 32 all assume something to sell. This one does not
 * sell anything, so the section keeps the job those rules are actually doing —
 * answering "what will this cost me?" before the visitor has to hunt for it —
 * and answers it in one character.
 */

const included = [
  'Every feature. There is no locked tier.',
  'No subscription, no renewal, no card.',
  'No account, so nothing to cancel.',
  'MIT licence. Fork it, ship it, sell it.',
] as const;
---

<section class="ps-screen border-t border-line bg-sunk" id="ps-price">
  <div class="ps-shell max-w-[46rem] text-center">
    <p class="ps-kicker">Price</p>

    <p
      class="mt-6 text-[clamp(5rem,18vw,9rem)] leading-none font-semibold tracking-[-0.06em] text-accent"
    >
      $0
    </p>

    <h2 class="mt-4 text-[clamp(1.6rem,3.4vw,2.2rem)]">
      Free, and staying free.
    </h2>

    <p class="mx-auto mt-5 max-w-[42ch] text-[1.05rem] text-muted">
      Charging would mean a licence server, a payment flow and an account
      system, three things that each need the network access this app
      deliberately does not have. The price is not a promotion. It is the
      architecture.
    </p>

    <ul class="mx-auto mt-10 grid max-w-[34rem] gap-3 text-left sm:grid-cols-2">
      {
        included.map((item) => (
          <li class="flex items-start gap-2.5 text-[0.95rem]">
            <svg
              class="mt-1 h-4 w-4 shrink-0 stroke-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 12.5l5.2 5.2L20 7" />
            </svg>
            {item}
          </li>
        ))
      }
    </ul>

    <a
      class="mt-11 inline-flex items-center gap-2.5 rounded-xl bg-ink px-6 py-3.5 text-[1rem] font-semibold text-paper no-underline transition-transform hover:-translate-y-0.5"
      href={site.downloadUrl}
      rel="noopener"
    >
      <DownloadIcon class="h-[18px] w-[18px]" />
      {site.ctaLabel}
    </a>
  </div>
</section>
