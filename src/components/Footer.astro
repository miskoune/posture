---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<section class="ps-closing">
  <div class="ps-shell">
    <h2>Sit back.</h2>
    <p class="ps-lede">
      Posture is being built in the open. Watch the repository and you will know
      the moment there is something to install.
    </p>
    <a class="ps-btn ps-btn-solid" href={site.repo} rel="noopener"
      >Follow on GitHub</a
    >
  </div>
</section>

<footer>
  <div class="ps-shell ps-row">
    <p>© {year} {site.name} · built in Paris</p>
    <nav aria-label="Footer">
      <a href="#ps-privacy">Privacy</a>
      <a href="#ps-faq">FAQ</a>
      <a href={site.repo} rel="noopener">Source</a>
    </nav>
  </div>
</footer>

<style>
  .ps-closing {
    padding-block: clamp(4.5rem, 11vw, 7.5rem);
    text-align: center;
  }
  .ps-closing .ps-lede {
    margin: 1.1rem auto 2rem;
    max-width: 42ch;
  }

  footer {
    border-top: 1px solid var(--line);
    padding-block: 1.8rem;
  }
  .ps-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .ps-row nav {
    display: flex;
    gap: 1.4rem;
  }
  .ps-row a {
    text-decoration: none;
  }
  .ps-row a:hover {
    color: var(--text);
  }
</style>
