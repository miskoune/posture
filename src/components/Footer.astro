---
import DownloadIcon from './DownloadIcon.astro';
import { site } from '../config/site';

/**
 * Rule 4 — finish strong: the last screen is the one people quote when they
 * share the link, so it calls back to the headline instead of trailing off
 * into a sitemap. Rule 15 — a real person's name and profile, no stock photo.
 */

const year = new Date().getFullYear();
---

<section class="border-t border-line py-[clamp(6rem,16vw,11rem)] text-center">
  <div class="ps-shell">
    <h2 class="mx-auto max-w-[16ch] text-[clamp(2.2rem,6vw,3.6rem)]">
      You just sat up straighter.
    </h2>

    <p class="mx-auto mt-6 max-w-[38ch] text-[1.05rem] text-muted">
      That small correction is the entire product. Posture repeats it every time
      you drift, long after this page is closed.
    </p>

    <a
      class="mt-10 inline-flex items-center gap-2.5 rounded-xl bg-ink px-6 py-3.5 text-[1rem] font-semibold text-paper no-underline shadow-float transition-transform hover:-translate-y-0.5"
      href={site.downloadUrl}
      rel="noopener"
    >
      <DownloadIcon class="h-[18px] w-[18px]" />
      {site.ctaLabel}
    </a>
  </div>
</section>

<footer class="border-t border-line py-7">
  <div
    class="ps-shell flex flex-wrap items-center justify-between gap-4 text-[0.86rem] text-muted"
  >
    <!-- Spacing lives in the strings: Astro drops newline-only whitespace
         between expressions, which once rendered "2026Posture". -->
    <p>
      {`© ${year} ${site.name} · built by `}<a
        class="underline underline-offset-2 hover:text-ink"
        href={site.author}
        rel="noopener">@miskoune</a
      >{' in Paris'}
    </p>

    <nav class="flex gap-6" aria-label="Footer">
      <a class="no-underline hover:text-ink" href="#ps-app">Inside the app</a>
      <a class="no-underline hover:text-ink" href="#ps-faq">FAQ</a>
      <a class="no-underline hover:text-ink" href={site.repo} rel="noopener">
        Source
      </a>
    </nav>
  </div>
</footer>
