---
import { compareRows, compareColumns } from '../data/compare';

/**
 * Rule 31 — people care why they should switch, not what the product does.
 * The alternatives are categories rather than brands, so every tick is a claim
 * about how that approach works, not a review of anyone's product.
 */
---

<section class="ps-screen">
  <div class="ps-shell">
    <p class="ps-kicker">Instead of</p>
    <h2 class="mt-4 max-w-[24ch] text-[clamp(1.9rem,4.2vw,2.9rem)]">
      The other three ways to fix your back.
    </h2>

    <div
      class="mt-12 -mx-[clamp(1.25rem,5vw,2.5rem)] overflow-x-auto px-[clamp(1.25rem,5vw,2.5rem)]"
    >
      <table class="w-full min-w-[36rem] border-collapse text-left">
        <thead>
          <tr>
            <th class="w-2/5 pb-4 text-[0.8rem] font-medium text-muted">
              <span class="sr-only">Capability</span>
            </th>
            {
              compareColumns.map((column, i) => (
                <th
                  class:list={[
                    'pb-4 text-center text-[0.86rem] font-semibold',
                    i === 0 ? 'text-accent' : 'text-muted',
                  ]}
                  scope="col"
                >
                  {column}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            compareRows.map((row) => (
              <tr class="border-t border-line">
                <th class="py-4 pr-4 text-[0.96rem] font-normal" scope="row">
                  {row.question}
                </th>
                {[row.posture, row.brace, row.cloud, row.willpower].map(
                  (yes, i) => (
                    <td class="py-4 text-center">
                      <span class="sr-only">{yes ? 'Yes' : 'No'}</span>
                      {yes ? (
                        <svg
                          class:list={[
                            'mx-auto h-[18px] w-[18px]',
                            i === 0 ? 'stroke-accent' : 'stroke-muted',
                          ]}
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke-width="2.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M4 12.5l5.2 5.2L20 7" />
                        </svg>
                      ) : (
                        <span
                          class="mx-auto block h-px w-4 bg-line-strong"
                          aria-hidden="true"
                        />
                      )}
                    </td>
                  ),
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
