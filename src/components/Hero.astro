---
import PostureFigure from './PostureFigure.astro';
import { site } from '../config/site';
---

<section class="ps-hero" id="ps-main">
  <div class="ps-shell ps-grid">
    <div class="ps-copy">
      <p class="ps-devnote"><i></i>In development — nothing to download yet</p>

      <h1>
        Your Mac already has a camera.<br /><em>Let it watch your back.</em>
      </h1>

      <p class="ps-lede">
        Posture notices the slow slide into a slouch and gives you one quiet
        nudge. It runs entirely on your Mac — no video leaves the device, no
        account, no cloud.
      </p>

      <div class="ps-actions">
        <a class="ps-btn ps-btn-solid" href={site.repo} rel="noopener">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
          Follow on GitHub
        </a>
        <a class="ps-btn ps-btn-ghost" href="#ps-how">How it works</a>
      </div>

      <p class="ps-meta">{site.requirements}</p>
    </div>

    <div class="ps-visual"><PostureFigure /></div>
  </div>
</section>

<style>
  .ps-hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3.5rem, 9vw, 7rem);
    position: relative;
    overflow: clip;
  }
  /* a soft green wash behind the figure, doing the work a photo would */
  .ps-hero::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 60vw;
    height: 70vh;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--good) 16%, transparent),
      transparent 66%
    );
    filter: blur(30px);
    pointer-events: none;
    z-index: -1;
  }

  .ps-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .ps-devnote {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 520;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--bg-elev);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }
  .ps-devnote i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--warn);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--warn) 22%, transparent);
  }

  h1 em {
    font-style: normal;
    color: var(--good);
  }

  .ps-lede {
    margin-top: 1.4rem;
  }

  .ps-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.1rem;
  }
  .ps-actions svg {
    width: 15px;
    height: 15px;
  }

  .ps-meta {
    margin-top: 1.3rem;
    font-size: 0.83rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .ps-grid {
      grid-template-columns: 1fr;
    }
    .ps-visual {
      order: -1;
    }
    .ps-lede {
      max-width: none;
    }
  }
</style>
