---
import AppIcon from './AppIcon.astro';
import CameraView from './CameraView.astro';
import MenuBarStrip from './MenuBarStrip.astro';

/**
 * The app is a square in the menu bar, so there is nothing to screenshot that
 * would still be true after a release. These are redrawn in the page's own
 * tokens instead: they follow dark mode, stay sharp on a phone, cost no image
 * bytes, and can be diffed against the Swift when either side moves.
 *
 * Every string and every value below is lifted from the app sources:
 * `StatusMenuController` for the menu, `NotificationNudger` for the banner.
 * Copied verbatim: if a string here stops matching the Swift, one of the two
 * is wrong and it is worth knowing which. The dashboard window itself is
 * mocked in DashboardWindow.astro, up in the hero.
 */

/** Submenus, drawn with the disclosure arrow macOS puts on them. */
const submenus = [
  'Sensitivity',
  'Wait before notifying',
  'Remind again while bad',
] as const;
---

<section class="ps-screen border-t border-line" id="ps-app">
  <div class="ps-shell">
    <p class="ps-kicker">Inside the app</p>

    <h2 class="mt-4 max-w-[26ch] text-[clamp(1.9rem,4.2vw,2.9rem)]">
      Almost all of it happens in the menu bar.
    </h2>

    <p class="mt-6 max-w-[58ch] text-[1.08rem] text-muted">
      A square next to the clock, one banner when you drift, and a small mirror
      so you can see what it saw. The window you tried at the top of the page is
      behind all that, and you can go a month without opening it.
    </p>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      <!-- 1 · the menu -->
      <figure class="ps-fig">
        <div class="ps-stage">
          <MenuBarStrip active badge="check" />

          <div class="ps-under">
            <div class="ps-pop ps-menu">
              <p class="ps-menu-state">Good posture</p>
              <hr class="ps-sep" />
              <p class="ps-menu-row is-hot">Open Dashboard</p>
              <p class="ps-menu-row">Calibrate, sit how you want to sit</p>
              <p class="ps-menu-row">Pause</p>
              <hr class="ps-sep" />
              {
                submenus.map((item) => (
                  <p class="ps-menu-row ps-menu-more">
                    {item}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M9 5l7 7-7 7" />
                    </svg>
                  </p>
                ))
              }
              <p class="ps-menu-row ps-menu-on">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 12.5l5.2 5.2L20 7"></path>
                </svg>
                Show preview when notified
              </p>
              <hr class="ps-sep" />
              <p class="ps-menu-row">Quit Posture</p>
            </div>
          </div>
        </div>

        <figcaption class="ps-cap">
          <strong>The menu.</strong> The verdict on top, then the only four things
          worth deciding. No preferences window, because there is nothing left to
          put in one.
        </figcaption>
      </figure>

      <!-- 2 · the nudge -->
      <figure class="ps-fig">
        <div class="ps-stage">
          <MenuBarStrip badge="cross" />

          <div class="ps-under">
            <div class="ps-pop ps-toast">
              <!-- Tailwind rather than a scoped rule: scoped styles do not
                   reach a child component's root element. -->
              <AppIcon
                class="h-[1.9rem] w-[1.9rem] shrink-0 rounded-[7px]"
                uid="toast"
              />
              <div class="ps-toast-body">
                <p class="ps-toast-head">
                  <span>Posture</span>
                  <span class="ps-toast-time">now</span>
                </p>
                <p class="ps-toast-text">Bad posture for a minute. Sit back.</p>
              </div>
            </div>
          </div>
        </div>

        <figcaption class="ps-cap">
          <strong>The notification.</strong> One banner, after a full minute of drift
          rather than on a timer. Stay folded over and it says so again five minutes
          later, in place of the first banner rather than under it. Sit back and it
          withdraws itself.
        </figcaption>
      </figure>

      <!-- 3 · the corner mirror -->
      <figure class="ps-fig">
        <div class="ps-stage">
          <MenuBarStrip badge="cross" />

          <div class="ps-under ps-under-end">
            <div class="ps-mirror"><CameraView /></div>
          </div>
        </div>

        <figcaption class="ps-cap">
          <strong>The mirror.</strong> 240 by 170 points at the bottom right, only
          while a notification stands. It shows the box it measured and the height
          you calibrated, so you can steer back without opening anything.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------- the shell */

  .ps-fig {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  /* A corner of the screen: menu bar across the top, everything else hanging
   * from it. A fixed height rather than flex: 1, because captions differ in
   * length and a stretching card would absorb the difference, leaving the
   * three cards unequal. Tall enough that the menu, the longest content,
   * still fits when its rows wrap on a narrow screen. */
  .ps-stage {
    display: flex;
    flex-direction: column;
    height: 22rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--sunk);
    box-shadow: var(--shadow-sm);
  }

  .ps-under {
    padding: 0.45rem 0.6rem 1rem;
  }

  .ps-under-end {
    display: flex;
    flex: 1;
    align-items: flex-end;
    padding-bottom: 0.6rem;
  }

  .ps-cap {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .ps-cap strong {
    font-weight: 620;
    color: var(--ink);
  }

  /* Anything that hangs off the menu bar. `margin-right` lands its right edge
   * under the status item: the clock plus one gap plus the bar's padding. The
   * width subtracts that inset so a narrow phone can never push it off the
   * left edge. */
  .ps-pop {
    width: min(15.5rem, calc(100% - 2.6rem));
    margin-left: auto;
    margin-right: 2.55rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in oklab, var(--raised) 92%, transparent);
    box-shadow: var(--shadow-lg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  /* -------------------------------------------------------------- the menu */

  .ps-menu {
    padding: 0.3rem;
    font-size: 0.74rem;
    line-height: 1.35;
  }

  .ps-menu-state,
  .ps-menu-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.26rem 0.45rem;
    border-radius: 5px;
  }

  .ps-menu-state {
    font-weight: 620;
    color: var(--ink);
  }

  .ps-menu-row {
    color: var(--muted);
  }

  /* One row under the pointer, so the mock reads as a live menu, not a list. */
  .ps-menu-row.is-hot {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .ps-menu-more {
    justify-content: space-between;
  }

  .ps-menu-more svg,
  .ps-menu-on svg {
    width: 0.7rem;
    height: 0.7rem;
    flex: 0 0 auto;
  }

  .ps-menu-on svg {
    color: var(--accent);
  }

  .ps-sep {
    height: 0;
    margin: 0.3rem 0.2rem;
    border: 0;
    border-top: 1px solid var(--line);
  }

  /* ------------------------------------------------------------- the nudge */

  .ps-toast {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    padding: 0.7rem 0.8rem;
    border-radius: 14px;
  }

  .ps-toast-body {
    min-width: 0;
    line-height: 1.35;
  }

  .ps-toast-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.76rem;
    font-weight: 620;
    color: var(--ink);
  }

  .ps-toast-time {
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--muted);
  }

  .ps-toast-text {
    margin-top: 0.1rem;
    font-size: 0.76rem;
    color: var(--muted);
  }

  /* ------------------------------------------------------------ the mirror */

  /* The panel is 240 by 170 points; it keeps that shape at every width. */
  .ps-mirror {
    width: min(15rem, 100%);
    margin-left: auto;
    aspect-ratio: 240 / 170;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
  }
</style>
