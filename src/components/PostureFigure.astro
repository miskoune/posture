---
/**
 * The hero visual: a side-profile figure at a desk that slouches, gets caught,
 * and straightens up — the whole product in one loop.
 *
 * Everything is a CSS transform on grouped SVG nodes, so it stays crisp at any
 * size and costs no JavaScript. The loop is 9s and pauses under
 * prefers-reduced-motion (handled globally in global.css).
 */
---

<div
  class="ps-stage"
  role="img"
  aria-label="A person sitting badly at a desk, receiving a notification, then sitting up straight."
>
  <svg viewBox="0 0 340 280" fill="none" aria-hidden="true">
    <!-- desk -->
    <path
      class="ps-desk"
      d="M150 214 H332"
      stroke-width="2.5"
      stroke-linecap="round"></path>
    <path
      class="ps-desk-leg"
      d="M318 214 V246"
      stroke-width="2.5"
      stroke-linecap="round"></path>

    <!-- display, with the camera notch the app actually uses -->
    <rect
      class="ps-screen"
      x="228"
      y="150"
      width="86"
      height="58"
      rx="6"
      stroke-width="2.5"></rect>
    <path
      class="ps-screen"
      d="M258 214 h26"
      stroke-width="2.5"
      stroke-linecap="round"></path>
    <circle class="ps-lens" cx="271" cy="158" r="2.6"></circle>

    <!-- chair -->
    <path
      class="ps-chair"
      d="M84 216 V250 M84 216 h34"
      stroke-width="2.5"
      stroke-linecap="round"></path>

    <!-- the body: hips are fixed, everything above them rotates -->
    <g class="ps-torso">
      <path
        class="ps-spine"
        d="M120 216 C116 190 118 166 122 142"
        stroke-width="9"
        stroke-linecap="round"></path>
      <path
        class="ps-arm"
        d="M124 152 C150 160 176 186 206 200"
        stroke-width="7"
        stroke-linecap="round"></path>
      <g class="ps-head">
        <circle class="ps-skull" cx="127" cy="118" r="21"></circle>
        <path
          class="ps-neck"
          d="M122 142 L126 132"
          stroke-width="8"
          stroke-linecap="round"></path>
      </g>
    </g>

    <!-- detection ring, pulsing from the camera toward the figure -->
    <circle class="ps-scan" cx="271" cy="158" r="10" stroke-width="2"></circle>
  </svg>

  <!-- macOS-style banner, timed to the moment the slouch is caught -->
  <div class="ps-nudge">
    <div class="ps-nudge-icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke-width="2.2"
        stroke-linecap="round"
      >
        <path d="M12 20V10"></path><path d="M8 13l4-4 4 4"></path><path
          d="M6 4h12"></path>
      </svg>
    </div>
    <div class="ps-nudge-body">
      <strong>Posture</strong>
      <span>You have been leaning in for 4 minutes. Sit back.</span>
    </div>
  </div>

  <div class="ps-state ps-state-slouch"><i></i>Bad posture</div>
  <div class="ps-state ps-state-upright"><i></i>Good posture</div>
</div>

<style>
  .ps-stage {
    position: relative;
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    aspect-ratio: 340 / 280;
  }

  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ps-desk,
  .ps-desk-leg,
  .ps-chair,
  .ps-screen {
    stroke: var(--line-strong);
  }
  .ps-screen {
    fill: var(--sunk);
  }
  .ps-lens {
    fill: var(--muted);
  }

  /* the figure carries the state colour */
  .ps-spine,
  .ps-arm,
  .ps-neck {
    stroke: var(--muted);
  }
  .ps-skull {
    fill: var(--muted);
  }

  .ps-spine,
  .ps-arm,
  .ps-neck,
  .ps-skull {
    animation: tint 9s ease-in-out infinite;
  }

  .ps-torso {
    transform-box: view-box;
    transform-origin: 120px 216px;
    animation: slouch 9s ease-in-out infinite;
  }

  .ps-head {
    transform-box: view-box;
    transform-origin: 122px 142px;
    animation: crane 9s ease-in-out infinite;
  }

  .ps-scan {
    stroke: var(--accent);
    transform-box: view-box;
    transform-origin: 271px 158px;
    animation: ping 9s ease-out infinite;
  }

  /* 0-38% slouched · 38-46% caught · 46-86% upright · 86-100% drifting back */
  @keyframes slouch {
    0%,
    38% {
      transform: rotate(15deg) translateY(3px);
    }
    50%,
    84% {
      transform: rotate(0deg) translateY(0);
    }
    100% {
      transform: rotate(15deg) translateY(3px);
    }
  }

  @keyframes crane {
    0%,
    38% {
      transform: rotate(13deg) translate(7px, 5px);
    }
    50%,
    84% {
      transform: rotate(0deg) translate(0, 0);
    }
    100% {
      transform: rotate(13deg) translate(7px, 5px);
    }
  }

  @keyframes tint {
    0%,
    40% {
      stroke: var(--muted);
      fill: var(--muted);
    }
    52%,
    82% {
      stroke: var(--accent);
      fill: var(--accent);
    }
    100% {
      stroke: var(--muted);
      fill: var(--muted);
    }
  }

  @keyframes ping {
    0%,
    30% {
      opacity: 0;
      transform: scale(0.6);
    }
    36% {
      opacity: 0.7;
      transform: scale(1);
    }
    48% {
      opacity: 0;
      transform: scale(4.5);
    }
    100% {
      opacity: 0;
      transform: scale(4.5);
    }
  }

  /* the notification */
  .ps-nudge {
    position: absolute;
    top: 2%;
    right: -4%;
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    width: min(17.5rem, 78%);
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--raised) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    animation: toast 9s ease-in-out infinite;
  }

  .ps-nudge-icon {
    flex: 0 0 auto;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: var(--accent);
    display: grid;
    place-items: center;
  }
  .ps-nudge-icon svg {
    width: 17px;
    height: 17px;
    stroke: var(--raised);
  }

  .ps-nudge-body {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
  }
  .ps-nudge-body strong {
    font-size: 0.8rem;
    font-weight: 620;
  }
  .ps-nudge-body span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  @keyframes toast {
    0%,
    33% {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
    }
    40%,
    62% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    72%,
    100% {
      opacity: 0;
      transform: translateY(-10px) scale(0.97);
    }
  }

  /* state pills */
  .ps-state {
    position: absolute;
    left: 0;
    bottom: 6%;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 560;
    border: 1px solid var(--line);
    opacity: 0;
  }
  .ps-state i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .ps-state-slouch {
    background: var(--sunk);
    color: var(--muted);
    animation: badge-bad 9s ease-in-out infinite;
  }
  .ps-state-slouch i {
    background: var(--muted);
  }

  .ps-state-upright {
    background: var(--accent-soft);
    color: var(--accent);
    animation: badge-good 9s ease-in-out infinite;
  }
  .ps-state-upright i {
    background: var(--accent);
  }

  @keyframes badge-bad {
    0%,
    40% {
      opacity: 1;
    }
    46%,
    88% {
      opacity: 0;
    }
    96%,
    100% {
      opacity: 1;
    }
  }
  @keyframes badge-good {
    0%,
    44% {
      opacity: 0;
    }
    52%,
    84% {
      opacity: 1;
    }
    92%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .ps-nudge {
      right: 0;
      width: min(15rem, 88%);
    }
  }

  /* one honest still frame when motion is unwelcome */
  @media (prefers-reduced-motion: reduce) {
    .ps-torso,
    .ps-head {
      transform: rotate(0deg);
    }
    .ps-spine,
    .ps-arm,
    .ps-neck {
      stroke: var(--accent);
    }
    .ps-skull {
      fill: var(--accent);
    }
    .ps-nudge {
      opacity: 1;
    }
    .ps-state-upright {
      opacity: 1;
    }
    .ps-state-slouch {
      opacity: 0;
    }
    .ps-scan {
      opacity: 0;
    }
  }
</style>
