---
/**
 * What `PreviewView` puts on screen: the camera, the face box Vision measured,
 * and the dashed guide line at the calibrated head height. Shared by the
 * dashboard mock and the corner mirror mock.
 *
 * Drawn, not captured. A screenshot here would mean publishing a photo of
 * somebody's face on a page whose whole argument is that the app never
 * produces one.
 *
 * It fills whatever box it is given, so the caller owns the shape: wrap it in
 * an element with a height, from an aspect-ratio or from grid stretch.
 *
 * With `animated`, the figure leans in and the face box follows it below the
 * calibrated line, then recovers. The timeline is shared with the verdict
 * card and the banner in DashboardWindow.astro: 0-40% good, 40-50% the slow
 * drift, 50-64% caught, 64-72% sitting back, 72-100% good. Change one side
 * and the other stops telling the same story.
 */
interface Props {
  readonly animated?: boolean | undefined;
}

const { animated = false } = Astro.props;
---

<div class="ps-cam" class:list={[animated && 'is-live']}>
  <svg
    class="ps-cam-svg"
    viewBox="0 0 320 240"
    preserveAspectRatio="xMidYMid slice"
    role="img"
    aria-label="The camera view: a head and shoulders with a box drawn around the face and a dashed line at the calibrated head height."
  >
    <rect width="320" height="240" fill="#0b0d0f"></rect>
    <ellipse cx="160" cy="150" rx="150" ry="120" fill="#14181c"></ellipse>

    <g class="ps-cam-body">
      <path
        d="M48 240 C62 176 114 154 160 154 C206 154 258 176 272 240 Z"
        fill="#262c32"></path>
      <rect x="146" y="128" width="28" height="32" rx="10" fill="#2f363d"
      ></rect>
      <ellipse cx="160" cy="104" rx="34" ry="42" fill="#333b43"></ellipse>
    </g>

    <!-- the calibrated head height, dashed white at 60% like guideLayer -->
    <path
      d="M0 62 H320"
      stroke="#ffffff"
      stroke-opacity="0.6"
      stroke-width="1.5"
      stroke-dasharray="6 6"></path>

    <!-- the measured face box: 3pt, corner radius min(12, width / 4) -->
    <rect
      class="ps-cam-box"
      x="124"
      y="60"
      width="72"
      height="88"
      rx="12"
      fill="none"
      stroke="var(--accent)"
      stroke-width="3"></rect>
  </svg>
</div>

<style>
  /* `height: 100%` rather than an aspect-ratio of its own: the caller decides
   * the shape, because the dashboard preview and the corner mirror are not
   * the same rectangle. */
  .ps-cam {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: #0b0d0f;
  }

  /* Absolute so the drawing fills whatever box the caller sizes, and crops
   * rather than letterboxes: a real preview is cropped the same way. The
   * caller owes it a height, from an aspect-ratio or from grid stretch. */
  .ps-cam-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* One transform for body and box: Vision's box tracks the face exactly, so
   * the two may never drift apart in the mock either. */
  .is-live .ps-cam-body,
  .is-live .ps-cam-box {
    transform-box: view-box;
    animation: ps-cam-drift 9s ease-in-out infinite;
  }

  /* The lean-in is slow (the product's whole point is that the slide is too
   * slow to feel); sitting back after the nudge is quick. */
  @keyframes ps-cam-drift {
    0%,
    40% {
      transform: translate(0, 0);
    }
    50%,
    64% {
      transform: translate(7px, 28px);
    }
    72%,
    100% {
      transform: translate(0, 0);
    }
  }

  /* One honest still frame when motion is unwelcome. */
  @media (prefers-reduced-motion: reduce) {
    .is-live .ps-cam-body,
    .is-live .ps-cam-box {
      animation: none;
    }
  }
</style>
