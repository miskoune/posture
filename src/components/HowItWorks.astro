---
import { steps } from '../data/steps';
---

<section class="ps-screen" id="ps-how">
  <div class="ps-shell">
    <p class="ps-kicker">How it works</p>
    <h2 class="mt-4 max-w-[20ch] text-[clamp(1.9rem,4.2vw,2.9rem)]">
      Three steps, then it gets out of the way.
    </h2>

    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        steps.map((step) => (
          <li class="border-t border-line pt-6">
            <span class="font-mono text-[0.8rem] tracking-[0.14em] text-accent tabular-nums">
              {step.n}
            </span>
            <h3 class="mt-3 text-[1.18rem] leading-snug">{step.title}</h3>
            <p class="mt-3 text-[0.97rem] text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
