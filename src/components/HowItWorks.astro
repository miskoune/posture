---
import { steps } from '../data/steps';
---

<section class="ps-how ps-section" id="ps-how">
  <div class="ps-shell">
    <div class="ps-head">
      <p class="ps-kicker">How it works</p>
      <h2>Three steps, then it gets out of the&nbsp;way.</h2>
    </div>

    <ol>
      {
        steps.map((s) => (
          <li>
            <span class="ps-num">{s.n}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ps-head {
    max-width: 50ch;
    margin-bottom: 3.2rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.2rem, 4vw, 3rem);
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    align-items: start;
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .ps-num {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--good);
    padding-top: 0.28rem;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin-bottom: 0.55rem;
    font-size: 1.2rem;
  }
  p {
    color: var(--muted);
    max-width: 62ch;
    font-size: 0.97rem;
  }
</style>
