---
import { stats } from '../data/stats';
import { privacyPoints } from '../data/privacy';

/**
 * Rule 3 — numbers instead of adjectives. "Private" is an adjective anyone can
 * type; 0 bytes and 0 accounts are claims you can check against the source.
 */
---

<section class="ps-screen border-t border-line bg-sunk" id="ps-privacy">
  <div class="ps-shell">
    <p class="ps-kicker">Privacy</p>
    <h2 class="mt-4 max-w-[22ch] text-[clamp(1.9rem,4.2vw,2.9rem)]">
      A camera app you can leave on.
    </h2>
    <p class="mt-5 max-w-[46ch] text-[1.08rem] text-muted">
      Pointing a webcam at yourself all day is a big ask, and it should be. Here
      is the entire answer to “where does the video go?”
    </p>

    <dl
      class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3"
    >
      {
        stats.map((stat) => (
          <div class="bg-raised p-7">
            <dt class="text-[3.4rem] leading-none font-semibold tracking-[-0.05em] text-accent tabular-nums">
              {stat.value}
            </dt>
            <dd class="mt-2">
              <p class="text-[1.02rem] font-semibold">{stat.label}</p>
              <p class="mt-2 text-[0.92rem] text-muted">{stat.note}</p>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        privacyPoints.map((point) => (
          <div>
            <h3 class="text-[1.02rem]">{point.title}</h3>
            <p class="mt-2 text-[0.94rem] text-muted">{point.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
