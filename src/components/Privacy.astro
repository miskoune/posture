---
import { privacyPoints } from '../data/privacy';
import { site } from '../config/site';
---

<section class="ps-privacy ps-section" id="ps-privacy">
  <div class="ps-shell">
    <div class="ps-head">
      <p class="ps-kicker">Privacy</p>
      <h2>A camera app you can actually leave&nbsp;on.</h2>
      <p class="ps-lede">
        Pointing a webcam at yourself all day is a big ask, and it should be.
        Posture is built so the honest answer to “where does the video go?” is
        <em>nowhere</em> — it never leaves the frame buffer.
      </p>
    </div>

    <div class="ps-grid">
      {
        privacyPoints.map((p) => (
          <article class="ps-point">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </div>

    <p class="ps-verify">
      Posture is open source. If you would rather not take any of this on trust,
      the camera and networking code is
      <a href={site.repo} rel="noopener">right there to read</a>.
    </p>
  </div>
</section>

<style>
  .ps-privacy {
    background: var(--bg-sunk);
    border-block: 1px solid var(--line);
  }

  .ps-head {
    max-width: 58ch;
    margin-bottom: 3rem;
  }
  .ps-head .ps-lede {
    margin-top: 1.1rem;
    max-width: 54ch;
  }
  .ps-head em {
    font-style: normal;
    color: var(--good);
    font-weight: 560;
  }

  .ps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .ps-point h3 {
    margin-bottom: 0.5rem;
  }
  .ps-point p {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .ps-verify {
    margin-top: 2rem;
    font-size: 0.94rem;
    color: var(--muted);
    max-width: 60ch;
  }
  .ps-verify a {
    color: var(--good);
    text-underline-offset: 3px;
  }
</style>
