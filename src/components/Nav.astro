---
import { site } from '../config/site';
import AppIcon from './AppIcon.astro';
import DownloadIcon from './DownloadIcon.astro';

const links = [
  { href: '#ps-app', label: 'Inside the app' },
  { href: '#ps-faq', label: 'FAQ' },
  { href: site.repo, label: 'GitHub' },
] as const;
---

<header class="ps-bar sticky top-0 z-50">
  <div class="ps-shell">
    <nav
      class="ps-float flex h-16 items-center justify-between gap-4"
      aria-label="Main"
    >
      <a
        class="flex items-center gap-2 text-[1.02rem] font-semibold tracking-tight no-underline"
        href="/"
      >
        <!-- the app icon: the slouch settling back to square -->
        <AppIcon class="h-6 w-6" uid="nav" />
        {site.name}
      </a>

      <div class="flex items-center gap-6">
        {
          links.map((link) => (
            <a
              class="hidden text-[0.9rem] text-muted no-underline transition-colors hover:text-ink sm:inline"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }

        <a
          class="inline-flex items-center gap-2 rounded-[10px] bg-ink px-4 py-2 text-[0.88rem] font-medium text-paper no-underline transition-transform hover:-translate-y-px"
          href={site.downloadUrl}
          rel="noopener"
        >
          <DownloadIcon class="h-4 w-4" />
          Download
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* At rest the bar sits flush with the page. Once the page scrolls under it,
   * the nav detaches into a floating blurred pill. */
  .ps-bar {
    transition: padding-block 0.35s ease;
  }

  .ps-float {
    border: 1px solid transparent;
    border-radius: 16px;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      padding 0.35s ease,
      height 0.35s ease;
  }

  .ps-bar.is-scrolled {
    padding-block: 0.5rem;
  }

  .ps-bar.is-scrolled .ps-float {
    height: 3.25rem;
    padding-inline: 1rem;
    background: color-mix(in srgb, var(--raised) 82%, transparent);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-color: var(--line);
    box-shadow: var(--shadow-card);
  }
</style>

<script>
  const bar = document.querySelector('.ps-bar');
  const onScroll = () => bar?.classList.toggle('is-scrolled', scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
