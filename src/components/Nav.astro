---
import { site } from '../config/site';
import GithubIcon from './GithubIcon.astro';

/**
 * Rule 16 — visitors look for the price early and use it to understand the
 * product, so "Price" keeps its slot in the header. The answer behind the link
 * happens to be zero.
 */

const links = [
  { href: '#ps-how', label: 'How it works' },
  { href: '#ps-price', label: 'Price' },
  { href: '#ps-faq', label: 'FAQ' },
] as const;
---

<header
  class="ps-bar sticky top-0 z-50 border-b border-transparent bg-paper/80 backdrop-blur-xl"
>
  <nav
    class="ps-shell flex h-16 items-center justify-between gap-4"
    aria-label="Main"
  >
    <a
      class="flex items-center gap-2 text-[1.02rem] font-semibold tracking-tight no-underline"
      href="/"
    >
      <!-- the app icon: the little man engraved in stone -->
      <svg class="h-6 w-6" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <linearGradient id="ps-stone" x1="0.24" y1="0" x2="0.76" y2="1">
            <stop offset="0" stop-color="#fdfbf4"></stop>
            <stop offset="0.45" stop-color="#d9d6c6"></stop>
            <stop offset="1" stop-color="#7a836a"></stop>
          </linearGradient>
        </defs>
        <rect x="2" y="2" width="96" height="96" rx="22" fill="url(#ps-stone)"
        ></rect>
        <circle cx="50" cy="27" r="10" fill="#17191c"></circle>
        <path
          d="M50 41 V64 M50 47.5 L36 57 M50 47.5 L64 57 M50 64 L39 83 M50 64 L61 83"
          stroke="#17191c"
          stroke-width="10"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"></path>
      </svg>
      {site.name}
    </a>

    <div class="flex items-center gap-6">
      {
        links.map((link) => (
          <a
            class="hidden text-[0.9rem] text-muted no-underline transition-colors hover:text-ink sm:inline"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }

      <a
        class="inline-flex items-center gap-2 rounded-[10px] bg-ink px-4 py-2 text-[0.88rem] font-medium text-paper no-underline transition-transform hover:-translate-y-px"
        href={site.repo}
        rel="noopener"
      >
        <GithubIcon class="h-4 w-4" />
        Star
      </a>
    </div>
  </nav>
</header>

<style>
  /* the hairline appears only once the page has scrolled under the bar */
  @supports (animation-timeline: scroll()) {
    .ps-bar {
      animation: ps-reveal-rule linear both;
      animation-timeline: scroll();
      animation-range: 0 80px;
    }
    @keyframes ps-reveal-rule {
      to {
        border-bottom-color: var(--line);
      }
    }
  }
</style>
