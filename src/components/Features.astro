---
import { features } from '../data/features';
---

<section class="section features">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Details</p>
      <h2>Small app, few opinions.</h2>
    </div>

    <div class="grid">
      {
        features.map((f) => (
          <article>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={f.icon} />
            </svg>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    background: var(--bg-sunk);
    border-block: 1px solid var(--line);
  }
  .head {
    max-width: 44ch;
    margin-bottom: 3rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: clamp(1.6rem, 4vw, 2.6rem);
  }

  article svg {
    width: 22px;
    height: 22px;
    stroke: var(--good);
    margin-bottom: 0.9rem;
  }

  h3 {
    margin-bottom: 0.45rem;
  }
  p {
    color: var(--muted);
    font-size: 0.94rem;
    max-width: 40ch;
  }
</style>
