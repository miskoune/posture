---
import '../styles/global.css';
import { site } from '../config/site';

export interface Props {
  /** Overrides the document title; defaults to "Posture · <tagline>". */
  readonly title?: string | undefined;
  readonly description?: string | undefined;
}

const {
  title = `${site.name} · ${site.tagline}`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link
      rel="preload"
      href="/fonts/Inter.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="theme-color"
      content="#faf8f1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0f1113"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Your posture is bad right now. Posture, a free Mac app."
    />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: site.name,
        applicationCategory: 'HealthApplication',
        operatingSystem: 'macOS 14 or later, Apple silicon',
        url: site.url,
        description,
        license: 'https://opensource.org/licenses/MIT',
        offers: {
          '@type': 'Offer',
          price: '0',
          priceCurrency: 'USD',
        },
      })}
    />
  </head>
  <body>
    <a
      class="absolute top-4 left-4 z-100 -translate-y-24 rounded-lg border border-line bg-raised px-4 py-3 no-underline transition-transform focus:translate-y-0"
      href="#ps-main">Skip to content</a
    >
    <slot />
  </body>
</html>
